# DeepSeek API 配置
# 复制为 .env.local 并填入 API Key
# 可选模型：deepseek-v4-flash（默认）、deepseek-v4-pro（项目设置页可覆盖）

AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# 数据存储目录（默认为项目根下 data/）
DATA_DIR=data

# RAG 向量检索（可选）—— OpenAI 兼容的 /embeddings 端点
# 不填则 settings 页禁用「向量检索」选项，BM25 关键词检索仍可用
# 示例：本地 Ollama（http://localhost:11434/v1）、硅基流动云端 BGE 等
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=bge-m3
